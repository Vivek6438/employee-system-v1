<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:http="http://www.mulesoft.org/schema/mule/http" xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd
http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd">
	
	<sub-flow name="employeeSub_Flow" doc:id="7afeddda-ab8f-4494-8a1b-61e66d0559f1" >
		<logger level="INFO" doc:name="start Logger" doc:id="439eb8e4-a929-40f8-8ade-ca58d35ae838" message="Api is started, endpoint employee"/>
		<ee:transform doc:name="Initialzing parameter" doc:id="0638e10b-6d6e-4b0f-9bb6-fbbc5ce82a8e" >
			<ee:message >
			</ee:message>
			<ee:variables >
				<ee:set-variable variableName="empId" ><![CDATA[%dw 2.0
output application/json
---
attributes.queryParams.empId]]></ee:set-variable>
				<ee:set-variable variableName="firstName" ><![CDATA[%dw 2.0
output application/json
---
attributes.queryParams.firstName]]></ee:set-variable>
				<ee:set-variable variableName="lastNmae" ><![CDATA[%dw 2.0
output application/json
---
attributes.queryParams.lastNmae]]></ee:set-variable>
				<ee:set-variable variableName="email" ><![CDATA[%dw 2.0
output application/json
---
attributes.queryParams.email]]></ee:set-variable>
				<ee:set-variable variableName="phone" ><![CDATA[%dw 2.0
output application/json
---
 attributes.queryParams.phone]]></ee:set-variable>
				<ee:set-variable variableName="designation" ><![CDATA[%dw 2.0
output application/json
---
attributes.queryParams.designation]]></ee:set-variable>
				<ee:set-variable variableName="salary" ><![CDATA[%dw 2.0
output application/json
---
attributes.queryParams.salary]]></ee:set-variable>
				<ee:set-variable variableName="joiningDate" ><![CDATA[%dw 2.0
output application/json
---
attributes.queryParams.joiningDate]]></ee:set-variable>
				<ee:set-variable variableName="cleint-id" ><![CDATA[%dw 2.0
output application/json
---
attributes.headers.'cleint-id'
]]></ee:set-variable>
				<ee:set-variable variableName="cleint-secret" ><![CDATA[%dw 2.0
output application/json
---
attributes.headers.'cleint-secret']]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<ee:transform doc:name="Transform Message" doc:id="b523c9e0-9c87-4f84-89c0-dcfc259050e2" >
			<ee:message >
			</ee:message>
			<ee:variables >
				<ee:set-variable variableName="querybody" ><![CDATA[%dw 2.0
output application/json skipNullOn = "everywhere"
---
{
	"empId" : vars.empId,
	"firstName" : vars.firstName,
	"lastNmae" : vars.lastNmae,
	"email" :  vars.email,
	"phone" : vars.phone,
	"designation" : vars.designation,
	"salary" : vars.salary,
	"joiningDate" :  vars.joiningDate,
}]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<logger level="INFO" doc:name="before call Logger" doc:id="e42ba639-12b3-4edb-a9c7-93a064402cab" message="Before Calling backend api"/>
		<http:request method="GET" doc:name="Employee Backend Calling" doc:id="3aec906e-1a7c-4ea7-ac19-08c5f0462808" config-ref="HTTP_Request_configuration_backend" path="/api/employees">
			<http:query-params ><![CDATA[#[vars.querybody]]]></http:query-params>
		</http:request>
		<logger level="INFO" doc:name="after call Logger" doc:id="f6029179-059d-41e7-94c2-85301200aded" message="after calling backend"/>
		<ee:transform doc:name="Response mapping" doc:id="108d92e4-dc9d-45c0-8d85-56e665085f8f" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
payload map{
	"empId": $.emp_id,
	"firstName": $.first_name,
	"lastNmae": $.last_name,
	"email": $.email,
	"phone": $.phone,
	"designation": $.designation,
	"salary": $.salary,
	"joiningDate": $.joining_date
}]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<logger level="INFO" doc:name="end Logger" doc:id="4c45d4b1-a387-4105-b9af-25ab984d8c5d" message="api is successfully called"/>
	</sub-flow>
</mule>
